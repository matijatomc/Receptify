<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Receptify.Views.RecipeListPage"
             Title="Recepti"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SubtleText" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="#6B7280"/>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#F1F1F1"/>
        </Style>

        <Style x:Key="TagChip" TargetType="Frame">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="BackgroundColor" Value="#F3F4F6"/>
            <Setter Property="BorderColor" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,18" Spacing="12">
            <Label Text="Recepti"
                   TextColor="{StaticResource TextColor}"
                   FontSize="28"
                   FontAttributes="Bold"/>

            <Frame HasShadow="False" CornerRadius="14" Padding="10" BackgroundColor="White" Margin="0,0,0,2">
                <Grid ColumnDefinitions="Auto,*">
                    <SearchBar x:Name="SearchEntry"
                               TextColor="{StaticResource TextColor}"
                               Grid.Column="1"
                               Placeholder="Pretraži po nazivu ili namirnici…"
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="Transparent"
                               CancelButtonColor="{StaticResource PrimaryColor}"/>
                </Grid>
            </Frame>

            <Label Text="Oznake" Style="{StaticResource SectionTitle}"/>
            <ScrollView Orientation="Horizontal">
                <CollectionView x:Name="TagFilterView"
                                ItemsSource="{Binding AllTags}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource TagChip}"
                                   BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                                   BorderColor="#E5E7EB">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference TagFilterView}, Path=BindingContext.ToggleTagCommand}"
                                                          CommandParameter="{Binding}"/>
                                </Frame.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" />
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Text="✎ Uredi oznake"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnEditTagsClicked"
                        Grid.Column="0"/>

                <Grid Grid.Column="3">
                    <Frame HasShadow="False" CornerRadius="12" Padding="8,2" BackgroundColor="White">
                        <HorizontalStackLayout Spacing="8">
                            <Picker x:Name="SortPicker"
                                    TextColor="{StaticResource TextColor}"
                                    Title="Sortiraj"
                                    SelectedIndexChanged="OnSortOptionChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Bez sortiranja</x:String>
                                        <x:String>Naziv (A-Z)</x:String>
                                        <x:String>Naziv (Z-A)</x:String>
                                        <x:String>Vrijeme (najkraće prvo)</x:String>
                                        <x:String>Vrijeme (najduže prvo)</x:String>
                                        <x:String>Ocjena (najbolje prvo)</x:String>
                                        <x:String>Ocjena (najgore prvo)</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </HorizontalStackLayout>
                    </Frame>
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView x:Name="RecipeCollection"
                            ItemsSource="{Binding FilteredRecipes}"
                            SelectionMode="None"
                            Margin="8,6,8,12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Nema dodanih recepata" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Dodaj svoj prvi recept preko izbornika."
                               Style="{StaticResource SubtleText}" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference RecipeCollection}, Path=BindingContext.RecipeTappedCommand}"
                                    CommandParameter="{Binding}"/>
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold" FontSize="20"/>

                                <ImageButton Grid.Row="0" Grid.Column="1"
                                             Source="{Binding FavoriteIcon}"
                                             Command="{Binding Source={x:Reference RecipeCollection}, Path=BindingContext.ToggleFavoriteCommand}"
                                             CommandParameter="{Binding}"
                                             BackgroundColor="Transparent"
                                             Padding="4"
                                             HeightRequest="28"
                                             WidthRequest="28"
                                             HorizontalOptions="End"/>

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <Image Source="clock.svg" HeightRequest="16" WidthRequest="16"/>
                                    <Label Text="{Binding CookingTimeMinutes, Converter={StaticResource TimeConverter}}"
                                           Style="{StaticResource SubtleText}"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <Image Source="star.svg" HeightRequest="16" WidthRequest="16"/>
                                    <Label Text="{Binding Rating, StringFormat='Ocjena: {0}/5'}"
                                           Style="{StaticResource SubtleText}"/>
                                </HorizontalStackLayout>

                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding TagList}"
                                       FontSize="13"
                                       TextColor="#374151"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="EditTagsPopup"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="#80000000"
              RowDefinitions="*,Auto,*"
              ColumnDefinitions="*,Auto,*"
              Padding="20">

            <Frame BackgroundColor="White"
                   Padding="18"
                   CornerRadius="16"
                   HasShadow="True"
                   Grid.Row="1" Grid.Column="1"
                   WidthRequest="340">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Uredi oznake" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center"/>

                    <CollectionView x:Name="EditTagCollection"
                                    ItemsSource="{Binding EditableTags}"
                                    HeightRequest="260">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="4">
                                    <Entry Text="{Binding Name}"
                                           HorizontalOptions="FillAndExpand"
                                           Placeholder="Naziv oznake"/>
                                    <Button Text="🗑"
                                            Clicked="OnDeleteTagClicked"
                                            CommandParameter="{Binding}"
                                            Grid.Column="1"
                                            BackgroundColor="Transparent"
                                            TextColor="#DC2626"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Text="Spremi" Clicked="OnSaveTags"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                CornerRadius="14"
                                Padding="14,8"
                                Grid.Column="0"/>
                        <Button Text="Odustani" Clicked="OnCancelEditTags" Style="{StaticResource OutlineButton}" Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
