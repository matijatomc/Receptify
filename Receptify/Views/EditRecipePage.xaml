<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Receptify.Views.EditRecipePage"
             Title="Uredi recept">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Naziv recepta" />
            <Entry x:Name="TitleEntry" Placeholder="Unesi naziv..." />

            <Label Text="Vrijeme kuhanja" />
            <Entry x:Name="CookingTimeEntry" Placeholder="npr. 45 min" />

            <Label Text="Sastojci" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Ingredients}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,5">
                            <Label Text="{Binding DisplayText}" Grid.Column="0" VerticalOptions="Center"/>

                            <Button Text="✎" 
                                Clicked="OnEditIngredientClicked" 
                                CommandParameter="{Binding .}" 
                                Grid.Column="1"
                                Padding="5,0"
                                FontSize="14" />

                            <Button Text="❌"
                                    Clicked="OnDeleteIngredientClicked"
                                    CommandParameter="{Binding .}"
                                    Grid.Column="2"
                                    Padding="5,0"
                                    FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <Label Text="Dodaj sastojak" FontAttributes="Bold"/>
            <Entry x:Name="IngredientNameEntry"
                   Placeholder="Unesi naziv namirnice..."
                   TextChanged="OnIngredientNameChanged"
                   Focused="OnIngredientEntryFocused"
                   Unfocused="OnIngredientEntryUnfocused" />

            <CollectionView x:Name="IngredientSuggestions"
                            IsVisible="False"
                            ItemsSource="{Binding FilteredIngredients}"
                            SelectionMode="None"
                            HeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="2"
                               BorderColor="LightGray"
                               BackgroundColor="#FFF7E5"
                               CornerRadius="6">
                            <Label Text="{Binding Name}" TextColor="Black">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIngredientSuggestionTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>



            <Entry x:Name="UnitEntry" Placeholder="Mjerna jedinica (npr. kg)" />
            <Entry x:Name="QuantityEntry" Placeholder="Količina" Keyboard="Numeric" />

            <Button Text="Dodaj sastojak" Clicked="OnAddIngredientClicked" />

            <Label Text="Upute" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Steps}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,5">
                            <Label Text="{Binding StepNumber}" 
                                   VerticalOptions="Center"
                                   Margin="0,5"
                                   Grid.Column="0" />

                            <Editor Text="{Binding Description}" 
                                    AutoSize="TextChanges"
                                    FontSize="14"
                                    Margin="5,0"
                                    Grid.Column="1" />

                            <Button Text="❌"
                                    Clicked="OnDeleteStepClicked"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center"
                                    Grid.Column="2" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid  ColumnDefinitions="*, Auto" Padding="0,5">
                <Editor x:Name="NewStepEntry" 
                        Placeholder="Nova uputa..." 
                        StyleId="NewStepEntry" 
                        FontSize="14" 
                        AutoSize="TextChanges" 
                        Grid.Column="0"  />
                <Button Text="+" 
                        Clicked="OnAddStepClicked" 
                        VerticalOptions="Start" 
                        Grid.Column="1" />
            </Grid>

            <Label Text="Oznake" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Tags}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5" ColumnDefinitions="Auto,*" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                            <Label Text="{Binding Name}" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <HorizontalStackLayout>
                <Entry x:Name="NewTagEntry" Placeholder="Dodaj novu oznaku..." />
                <Button Text="+" Clicked="OnAddTagClicked" />
            </HorizontalStackLayout>

            <Button Text="Spremi promjene" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
