<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Receptify.Views.ShoppingListPage"
             Title="Popis namirnica"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#F1F1F1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#DC2626"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20,18" Spacing="12">

        <Label Text="Popis namirnica" Style="{StaticResource SectionTitle}" />

        <Frame Style="{StaticResource CardFrame}" HasShadow="True" IsVisible="{Binding IsNotEmpty}">
            <CollectionView ItemsSource="{Binding ShoppingItems}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Nema dodanih namirnica."
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,8">
                            <CheckBox IsChecked="{Binding IsChecked}"
                                      CheckedChanged="OnItemCheckedChanged"
                                      VerticalOptions="Center"/>
                            <Label Grid.Column="1" VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="Quantity"/>
                                        <Binding Path="Unit"/>
                                        <Binding Path="Name"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>

        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="16" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Nema dodanih namirnica."
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0"/>
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsNotEmpty}">
            <Button Text="🗑 Izbriši označeno"
                    Grid.Column="0"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnDeleteCheckedClicked"/>
            <Button Text="🧹 Izbriši sve"
                    Grid.Column="1"
                    Style="{StaticResource DangerButton}"
                    Clicked="OnDeleteAllClicked"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>
