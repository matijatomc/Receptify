<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Receptify.Views.RecipeDetailPage"
             Title="Detalji recepta"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubtleText" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="#6B7280"/>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#F1F1F1"/>
        </Style>

        <Style x:Key="Chip" TargetType="Frame">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,10,0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HasShadow" Value="False"/>
            <Setter Property="BackgroundColor" Value="#F3F4F6"/>
            <Setter Property="BorderColor" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#DC2626"/>
            <Setter Property="BorderColor" Value="#DC2626"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="6">

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding Recipe.Title}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextColor}" />

                <ImageButton Grid.Row="0" Grid.Column="1"
                             Source="{Binding FavoriteIcon}"
                             Command="{Binding ToggleFavoriteCommand}"
                             BackgroundColor="Transparent"
                             Padding="4"
                             HeightRequest="30"
                             WidthRequest="30"
                             HorizontalOptions="End"/>

                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,6,0,0">
                    <Frame Style="{StaticResource Chip}">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="clock.png" HeightRequest="16" WidthRequest="16"/>
                            <Label Text="{Binding Recipe.CookingTimeMinutes, Converter={StaticResource TimeConverter}}"
                                   Style="{StaticResource SubtleText}"/>
                        </HorizontalStackLayout>
                    </Frame>
                </HorizontalStackLayout>
            </Grid>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Oznake" Style="{StaticResource SectionTitle}"/>
                    <Label Text="{Binding TagList}"
                           FontSize="13"
                           TextColor="#374151"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sastojci" Style="{StaticResource SectionTitle}"/>
                    <CollectionView ItemsSource="{Binding Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="0,4">
                                    <Label Text="•" Margin="0,0,8,0" />
                                    <Label Text="{Binding DisplayText}" Grid.Column="1" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Upute" Style="{StaticResource SectionTitle}"/>
                    <CollectionView ItemsSource="{Binding Steps}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="0,4">
                                    <Frame Style="{StaticResource Chip}" Padding="8,4" Margin="0,0,10,0">
                                        <Label Text="{Binding Order}" FontAttributes="Bold" />
                                    </Frame>
                                    <Label Text="{Binding Description}" Grid.Column="1" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Bilješka i ocjena" Style="{StaticResource SectionTitle}"/>

                    <Editor Text="{Binding Recipe.Note}"
                            TextColor="{StaticResource TextColor}"
                            AutoSize="TextChanges"
                            Placeholder="Upiši bilješku o receptu..."
                            BackgroundColor="#FBFBFB" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Slider Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Minimum="0" Maximum="5"
                                Value="{Binding Recipe.Rating}" x:Name="RatingSlider" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Source={x:Reference RatingSlider}, Path=Value, StringFormat='Ocjena: {0:F0}'}"
                               Style="{StaticResource SubtleText}"/>
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="💾 Spremi"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnSaveNoteClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="10,0,10,10">
                <Button Text="📝 Stvori popis namirnica"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnGenerateShoppingListClicked"
                        Grid.Column="0"/>
                <Button Text="Uredi recept"
                        Style="{StaticResource OutlineButton}"
                        Clicked="OnEditClicked"
                        Grid.Column="1"/>
            </Grid>

            <Button Text="Izbriši recept"
                    Style="{StaticResource DangerButton}"
                    Margin="10,0,10,24"
                    Clicked="OnDeleteRecipeClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
