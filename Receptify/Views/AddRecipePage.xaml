<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Receptify.Views.AddRecipePage"
             Title="Dodaj recept"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubtleText" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="#6B7280"/>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="BorderColor" Value="#F1F1F1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BackgroundColor" Value="#F3F4F6"/>
            <Setter Property="TextColor" Value="#111827"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="8">

            <Label Text="Dodaj recept" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />

            <Frame Style="{StaticResource CardFrame}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

                    <Label Text="Naziv recepta" Style="{StaticResource SectionTitle}" Grid.Row="0"/>
                    <Entry x:Name="TitleEntry"
                           TextColor="{StaticResource TextColor}"
                           Grid.Row="1"
                           Placeholder="Unesi naziv..."
                           ClearButtonVisibility="WhileEditing"/>

                    <Label Text="Vrijeme kuhanja" Style="{StaticResource SectionTitle}" Grid.Row="2" Margin="0,8,0,0"/>
                    <Entry x:Name="CookingTimeEntry"
                           TextColor="{StaticResource TextColor}"
                           Grid.Row="3"
                           Placeholder="npr. 45 min"
                           ClearButtonVisibility="WhileEditing"/>
                </Grid>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sastojci" Style="{StaticResource SectionTitle}"/>

                    <CollectionView ItemsSource="{Binding Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,6">
                                    <Label Text="{Binding DisplayText}" Grid.Column="0" VerticalOptions="Center"/>
                                    <Button Text="✎"
                                            Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnEditIngredientClicked"
                                            CommandParameter="{Binding .}"/>
                                    <Button Text="❌"
                                            Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnDeleteIngredientClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Dodaj sastojak" Style="{StaticResource SectionTitle}"/>

                    <Entry x:Name="IngredientNameEntry"
                           TextColor="{StaticResource TextColor}"
                           Placeholder="Unesi naziv namirnice..."
                           TextChanged="OnIngredientNameChanged"
                           Focused="OnIngredientEntryFocused"
                           Unfocused="OnIngredientEntryUnfocused"
                           ClearButtonVisibility="WhileEditing"/>

                    <CollectionView x:Name="IngredientSuggestions"
                                    IsVisible="False"
                                    ItemsSource="{Binding FilteredIngredients}"
                                    SelectionMode="None"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" Margin="2,2,2,0"
                                       BorderColor="#E5E7EB"
                                       BackgroundColor="#FFF7E5"
                                       CornerRadius="10">
                                    <Label Text="{Binding Name}" TextColor="#111827">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnIngredientSuggestionTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Entry x:Name="UnitEntry"
                               TextColor="{StaticResource TextColor}"
                               Placeholder="Mjerna jedinica (npr. kg, g, ml)"
                               Grid.Column="0"/>
                        <Entry x:Name="QuantityEntry"
                               TextColor="{StaticResource TextColor}"
                               Placeholder="Količina"
                               Keyboard="Numeric"
                               Grid.Column="1"
                               WidthRequest="120"/>
                        <Button Text="Dodaj"
                                Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnAddIngredientClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Upute" Style="{StaticResource SectionTitle}"/>

                    <CollectionView ItemsSource="{Binding Steps}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,6" ColumnSpacing="8">
                                    <Frame Padding="8,4" CornerRadius="12" BackgroundColor="#F3F4F6" BorderColor="#E5E7EB" HasShadow="False">
                                        <Label Text="{Binding StepNumber}" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                                    </Frame>

                                    <Editor Text="{Binding Description}"
                                            TextColor="{StaticResource TextColor}"
                                            AutoSize="TextChanges"
                                            FontSize="14"
                                            Grid.Column="1"/>

                                    <Button Text="❌"
                                            Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnDeleteStepClicked"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Editor x:Name="NewStepEntry"
                                TextColor="{StaticResource TextColor}"
                                Placeholder="Nova uputa..."
                                AutoSize="TextChanges"
                                Grid.Column="0"/>
                        <Button Text="+"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnAddStepClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Oznake" Style="{StaticResource SectionTitle}"/>

                    <CollectionView ItemsSource="{Binding Tags}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnDefinitions="Auto,*" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Name}" Grid.Column="1" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="NewTagEntry" 
                               TextColor="{StaticResource TextColor}"
                               Placeholder="Nova oznaka..." 
                               Grid.Column="0"/>
                        <Button Text="Dodaj" Grid.Column="1" Style="{StaticResource OutlineButton}" Clicked="OnAddTagClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,24">
                <Button Text="Spremi recept"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
